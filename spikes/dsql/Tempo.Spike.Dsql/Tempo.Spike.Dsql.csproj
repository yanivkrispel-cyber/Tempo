<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AWSProjectType>Lambda</AWSProjectType>
    <RootNamespace>Tempo.Spike.Dsql</RootNamespace>
    <AssemblyName>Tempo.Spike.Dsql</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.AuroraDsql.Npgsql" Version="1.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

</Project>
