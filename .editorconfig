root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

[*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,css,html}]
indent_size = 2

[*.csproj]
indent_size = 2

[*.props]
indent_size = 2
