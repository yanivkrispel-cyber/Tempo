<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tempo.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- CA1707 (no underscores in identifiers) conflicts with the standard
         xUnit Method_Scenario_ExpectedBehavior test naming convention used
         throughout this project. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Coverlet.Collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\Tempo.Api\Tempo.Api.csproj" />
    <ProjectReference Include="..\..\backend\Tempo.Contracts\Tempo.Contracts.csproj" />
    <ProjectReference Include="..\..\backend\Tempo.Worker\Tempo.Worker.csproj" />
  </ItemGroup>

</Project>
