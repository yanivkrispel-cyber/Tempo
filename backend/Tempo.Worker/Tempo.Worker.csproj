<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tempo.Worker</RootNamespace>
    <AWSProjectType>Lambda</AWSProjectType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A class library gets no runtimeconfig.json by default, and the managed
         .NET Lambda runtime refuses to start without one (Runtime.ExitError,
         first dev deploy 2026-10-14). -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.SQSEvents" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Contracts\Tempo.Contracts.csproj" />
    <ProjectReference Include="..\Tempo.Platform\Tempo.Platform.csproj" />
  </ItemGroup>

</Project>
